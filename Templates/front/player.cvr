@include('almanac::front/styles')

@php
    $dark = ($themeMode ?? 'light') === 'dark';

    $crest = static function (array $row, string $light = 'logo', string $shade = 'logo_dark') use ($dark): string {
        $preferred = $dark ? (string) ($row[$shade] ?? '') : (string) ($row[$light] ?? '');

        return trim($preferred) !== ''
            ? $preferred
            : (string) ($row[$light] ?? $row[$shade] ?? '');
    };

    /*
     * Initials, for the players ESPN has no headshot for. That is not a rare
     * case — every player CFBD could not match to an ESPN athlete carries a
     * negative id and no picture — so it has to look deliberate rather than
     * broken. See Players::headshot().
     */
    $initials = '';

    foreach (preg_split('/\s+/', trim((string) $player['name'])) ?: [] as $part) {
        if ($part !== '') {
            $initials .= mb_strtoupper(mb_substr($part, 0, 1));
        }
    }

    $initials = mb_substr($initials, 0, 2);

    /*
     * Career stats arrive as one row per stat type. Pivoted here into a table
     * per category — seasons down, stat types across — which is how a stat line
     * is read everywhere else in the sport.
     */
    $columns = [];

    foreach ($career as $seasonRow) {
        foreach ($seasonRow['categories'] as $category => $types) {
            foreach ($types as $type => $value) {
                $columns[$category][$type] = true;
            }
        }
    }
@endphp

<div class="alm-player-head">
    {#
        🚨 The initials are ALWAYS rendered, with the photo laid over them, and
        the photo removes itself if it 404s.

        A positive id means CFBD matched the player to an ESPN athlete — it does
        NOT mean ESPN has a picture of him. Plenty of real athlete ids have no
        headshot (Jared Curtis at Vanderbilt, among many), and the img then
        renders as a broken-image icon in a 96px circle. There is no way to know
        in advance without a request per player, and there are 41,588 of them.

        So the fallback sits underneath rather than being chosen instead, and
        `onerror` uncovers it. Nothing flashes: the photo only ever paints once
        it has loaded.
    #}
    <div class="alm-shot-wrap">
        <div class="alm-initials" aria-hidden="true">{{ $initials }}</div>
        @notempty($headshot)
        <img class="alm-shot" src="{{ $headshot }}" alt="" width="96" height="96"
             onerror="this.remove()">
        @endnotempty
    </div>

    <div>
        <h2>{{ $player['name'] }}</h2>

        <div class="alm-hero-meta">
            {# Null check, not @notempty — see the note on the roster table. #}
            @if ($player['jersey'] !== null)#{{ $player['jersey'] }} · @endif
            @notempty($player['position']){{ $player['position'] }} · @endnotempty
            @notempty($classYear){{ __($classYear) }}@endnotempty
        </div>

        <div class="alm-hero-meta">
            @notempty($height){{ $height }}@endnotempty@notempty($player['weight']) · {{ $player['weight'] }} @lang('almanac.lbs')@endnotempty
            @notempty($player['home_city']) · {{ $player['home_city'] }}@endnotempty@notempty($player['home_state']), {{ $player['home_state'] }}@endnotempty
        </div>

        @notempty($player['team_slug'])
        <p>
            <a class="alm-team" href="/almanac/team/{{ $player['team_slug'] }}">
                @php $teamLogo = $crest($player); @endphp
                @notempty($teamLogo)<img class="alm-crest" src="{{ $teamLogo }}" alt="" width="28" height="28" style="--alm-crest: 28px">@endnotempty
                <span class="alm-team-name">{{ $player['school'] }}</span>
            </a>
        </p>
        @endnotempty
    </div>
</div>

{#
    🚨 The recruiting panel comes BEFORE the stats, and that ordering is the
    whole point of joining the two datasets. A true freshman has no stats at all
    — he is exactly who somebody looks up in February — and a page that led with
    an empty stat table and buried his class, stars and high school underneath
    would be worthless in the one case it was built for.
#}
