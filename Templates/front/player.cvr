@notempty($career)
<section class="alm-section alm-career">
    <h3>@lang('almanac.career')</h3>

    @each ($columns as $category => $types)
    <h4>{{ ucfirst($category) }}</h4>

    <div class="alm-scroll">
        <table class="alm-table">
            <thead>
                <tr>
                    <th>@lang('almanac.season')</th>
                    <th>@lang('almanac.team')</th>
                    @each (array_keys($types) as $type)
                    <th>{{ $type }}</th>
                    @endeach
                </tr>
            </thead>
            <tbody>
                @each ($career as $seasonRow)
                @if (isset($seasonRow['categories'][$category]))
                <tr>
                    <td>{{ $seasonRow['season'] }}</td>
                    <td>
                        @notempty($seasonRow['team_slug'])
                        <a href="/almanac/team/{{ $seasonRow['team_slug'] }}">{{ $seasonRow['team'] }}</a>
                        @endnotempty
                    </td>
                    @each (array_keys($types) as $type)
                    <td>{{ $seasonRow['categories'][$category][$type] ?? '—' }}</td>
                    @endeach
                </tr>
                @endif
                @endeach
            </tbody>
        </table>
    </div>
    @endeach
</section>
