@notempty($gameLog)
<section class="alm-section">
    <h3>@lang('almanac.game_log', ['season' => $logSeason])</h3>

    @notempty($statSeasons)
    <form class="alm-filters" method="get" action="/almanac/player/{{ $player['slug'] }}">
        <div>
            <label for="alm-log-season">@lang('almanac.season')</label>
            <select id="alm-log-season" name="season" onchange="this.form.submit()">
                @each ($statSeasons as $option)
                <option value="{{ $option }}"@if ((int) $option === (int) $logSeason) selected@endif>{{ $option }}</option>
                @endeach
            </select>
        </div>
        <noscript><button class="btn btn-secondary btn-sm" type="submit">@lang('almanac.go')</button></noscript>
    </form>
    @endnotempty

    <div class="alm-scroll">
        <table class="alm-table">
            <thead>
                <tr>
                    <th>@lang('almanac.week')</th>
                    <th>@lang('almanac.opponent')</th>
                    <th>@lang('almanac.stat_line')</th>
                </tr>
            </thead>
            <tbody>
                @each ($gameLog as $game)
                <tr>
                    <td class="alm-num">{{ $game['week'] }}</td>
                    <td>
                        @if (($game['home_away'] ?? '') === 'away')@lang('almanac.at') @endif
                        @notempty($game['opponent_slug'])
                        <a href="/almanac/team/{{ $game['opponent_slug'] }}">{{ $game['opponent'] }}</a>
                        @endnotempty
                        @empty($game['opponent_slug']){{ $game['opponent'] }}@endempty
                    </td>
                    <td>
                        @php
                            /* One readable line rather than forty sparse columns:
                             * a receiver and a punter share no stat types at all,
                             * so a fixed grid would be mostly dashes. */
                            $parts = [];

                            foreach ($game['categories'] as $cat => $types) {
                                $bits = [];

                                foreach ($types as $type => $value) {
                                    $bits[] = $value . ' ' . $type;
                                }

                                $parts[] = ucfirst($cat) . ': ' . implode(', ', $bits);
                            }
                        @endphp
                        {{ implode(' · ', $parts) }}
                    </td>
                </tr>
                @endeach
            </tbody>
        </table>
    </div>
</section>
@endnotempty

