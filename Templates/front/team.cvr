</div>

{# A season the visitor can change. Only years Roster holds are offered. #}
@notempty($seasons)
<form class="alm-filters" method="get" action="/almanac/team/{{ $team['slug'] }}">
    <div>
        <label for="alm-season">@lang('almanac.season')</label>
        <select id="alm-season" name="season" onchange="this.form.submit()">
            @each ($seasons as $row)
            <option value="{{ $row['season'] }}"@if ((int) $row['season'] === (int) $season) selected@endif>{{ $row['season'] }}</option>
            @endeach
        </select>
    </div>
    <noscript><button class="btn btn-secondary btn-sm" type="submit">@lang('almanac.go')</button></noscript>
</form>
@endnotempty

<section class="alm-section">
    <h3>@lang('almanac.roster', ['season' => $season])</h3>

    @empty($roster)
    <div class="empty-state"><p>@lang('almanac.no_roster')</p></div>
    @endempty

    @each ($roster as $group => $rows)
    {#
        🚨 A group the provider named is printed as the provider named it —
        "Pitchers", "Centers", "Special Team". Falling through to
        `almanac.group.other` would relabel every group on every professional
        roster as "Other", which is wrong and looks like a bug rather than a
        missing translation. Only football's own four are translated, because
        only those four are ours to name.
    #}
    <h4>@if(isset($groupLabels[$group])){{ __($groupLabels[$group]) }}@else{{ $group }}@endif</h4>

    <div class="alm-scroll">
        <table class="alm-table">
            <thead>
                <tr>
                    <th>@lang('almanac.jersey')</th>
                    <th>@lang('almanac.player')</th>
                    <th>@lang('almanac.position')</th>
                    <th>@lang('almanac.class')</th>
                    <th>@lang('almanac.height')</th>
                    <th>@lang('almanac.weight')</th>
                    <th>@lang('almanac.hometown')</th>
                </tr>
            </thead>
            <tbody>
                @each ($rows as $row)
                <tr>
                    {#
                        🚨 A null check, NOT @notempty. Number 0 has been legal
                        in college football since 2020 and is common now — AK
                        Dear wears it for Alabama — and `0` is falsy in PHP, so
                        @notempty renders an empty cell for a jersey the player
                        genuinely has.
                    #}
                    <td class="alm-num">@if ($row['jersey'] !== null){{ $row['jersey'] }}@endif</td>
                    <td><a href="/almanac/player/{{ $row['slug'] }}">{{ $row['name'] }}</a></td>
                    <td>{{ $row['position'] }}</td>
                    <td>
                        @php $class = $players->classYear(isset($row['class_year']) ? (int) $row['class_year'] : null); @endphp
                        @notempty($class){{ __($class) }}@endnotempty
                    </td>
                    <td>
                        @php $ht = $players->height(isset($row['height']) ? (int) $row['height'] : null); @endphp
                        @notempty($ht){{ $ht }}@endnotempty
                    </td>
                    <td>@notempty($row['weight']){{ $row['weight'] }}@endnotempty</td>
                    <td>@notempty($row['home_city']){{ $row['home_city'] }}@endnotempty@notempty($row['home_state']), {{ $row['home_state'] }}@endnotempty</td>
                </tr>
                @endeach
            </tbody>
        </table>
    </div>
    @endeach
</section>

