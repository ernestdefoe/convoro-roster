            <div>
                <span class="alm-stat-label">@lang('almanac.sp_rating')</span>
                <span class="alm-stat-value">#{{ $record['sp_rank'] }}</span>
            </div>
            @endnotempty
            @endnotempty

            @notempty($classRank['rank'])
            <div>
                <span class="alm-stat-label">@lang('almanac.class_rank')</span>
                <span class="alm-stat-value">#{{ $classRank['rank'] }}</span>
            </div>
            @endnotempty
        </div>
