@include('almanac::front/styles')

@php
    $dark = ($themeMode ?? 'light') === 'dark';

    /* See the note in front/index.cvr — both marks are stored, both are used. */
    $crest = static function (array $row, string $light = 'logo', string $shade = 'logo_dark') use ($dark): string {
        $preferred = $dark ? (string) ($row[$shade] ?? '') : (string) ($row[$light] ?? '');

        return trim($preferred) !== ''
            ? $preferred
            : (string) ($row[$light] ?? $row[$shade] ?? '');
    };

    $logo = $crest($team);

    $groupLabels = [
        'offense' => 'almanac.group.offense',
        'defense' => 'almanac.group.defense',
        'specialists' => 'almanac.group.specialists',
        'other' => 'almanac.group.other',
    ];
@endphp

<div class="alm-hero">
    @notempty($logo)
    <img class="alm-crest" src="{{ $logo }}" alt="" width="76" height="76">
    @endnotempty

    <div>
        <h2>{{ $team['school'] }}@notempty($team['mascot']) <span class="alm-team-sub">{{ $team['mascot'] }}</span>@endnotempty</h2>

        <div class="alm-hero-meta">
            {{ $team['conference'] }}@notempty($team['venue']) · {{ $team['venue'] }}@endnotempty@notempty($team['venue_city']), {{ $team['venue_city'] }}@endnotempty
        </div>

        <div class="alm-stat-row">
