{#
    🚨 This panel renders only when the CONTROLLER decided the viewer may see
    that forum. `$topics` arrives empty otherwise. Nothing here re-checks, and
    nothing here should start listing forums it was not handed.
#}
@notempty($topics)
<section class="alm-section">
    <h3>@lang('almanac.forum_recent', ['school' => $team['school']])</h3>
    <ul class="alm-topic-list">
        @each ($topics as $topic)
        <li>
            <a href="/topic/{{ $topic['id'] }}-{{ $topic['slug'] }}">{{ $topic['title'] }}</a>
            <span class="alm-count">{{ __n('almanac.post_count', (int) $topic['post_count']) }}</span>
        </li>
        @endeach
    </ul>
</section>
