    <div class="admin-card">
        <div class="admin-card-header">@lang('almanac.admin.heading_api')</div>
        <div class="admin-card-body">
            @if ($borrowed)<p class="admin-hint">@lang('almanac.admin.api_key_borrowed')</p>@endif

            {#
                🚨 There is no `value` here and there never may be. A stored
                credential printed back into a form is a credential in a browser
                cache, in a screenshot, and in the support ticket that
                screenshot is attached to. A blank box means "leave it alone".

                🚨 `text`, not `password`. Nothing is exposed by that — the box
                is empty on every load either way — and the password-manager
                hints are off because this credential belongs to a data provider
                rather than to the administrator's account, so offering to save
                it as a login is both wrong and a popup to dismiss every visit.
            #}
            <div class="admin-form-group">
                <label for="almanac_cfbd_key">@lang('almanac.admin.api_key')</label>
                <input type="text" id="almanac_cfbd_key" name="almanac_cfbd_key"
                       class="admin-input input-lg" autocomplete="off"
                       data-1p-ignore data-lpignore="true" data-form-type="other"
                       placeholder="@if($settings->configured())@lang('almanac.admin.unchanged')@endif">
                <div class="form-hint">@lang('almanac.admin.api_key_note')</div>
            </div>
        </div>
    </div>

