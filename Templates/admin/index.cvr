{#
    Every school and the site its photographs come from.

    🚨 A form PER ROW, outside the settings form above — a form inside a form is
    not nested by any browser, it is closed early, and the outer one silently
    stops submitting the fields that follow it.

    Schools with no site sort first, because they are the only rows anybody
    opens this table to deal with.
#}
<div class="admin-card">
    <div class="admin-card-header">@lang('almanac.admin.heading_sites')</div>
    <div class="admin-card-body">
        <p class="admin-hint">@lang('almanac.admin.sites_note')</p>

        <form method="POST" action="/admin/almanac/photos" class="admin-inline-form">
            @csrf
            <button type="submit" class="admin-btn admin-btn-sm">@lang('almanac.admin.photos_now')</button>
        </form>

        {#
            🚨 Rows, not a table. A `<form>` inside a `<tr>` is not nested by
            any browser — `tr` accepts only cells, so the parser lifts the form
            out and every input in the row ends up belonging to no form at all.
            The row would look right, submit nothing, and say it saved.
        #}
        @each ($sites as $site)
        <form method="POST" action="/admin/almanac/site" class="alm-site-row">
            @csrf
            <input type="hidden" name="team" value="{{ $site['id'] }}">

            <span class="alm-site-school">{{ $site['school'] }}</span>

            <input type="text" name="domain" class="admin-input" autocomplete="off"
                   aria-label="@lang('almanac.admin.site_domain')"
                   value="{{ $site['site_domain'] }}" placeholder="rolltide.com">

            <select name="platform" class="admin-input" aria-label="@lang('almanac.admin.site_platform')">
                <option value=""></option>
                @each ($platforms as $platform)
                <option value="{{ $platform }}"
                    @if($site['site_platform'] === $platform)selected @endif>{{ $platform }}</option>
                @endeach
            </select>

            <input type="number" name="sport_id" class="admin-input alm-site-sport" min="0"
                   aria-label="@lang('almanac.admin.site_sport')" value="{{ $site['site_sport_id'] }}">

            <span class="alm-site-state">
                @empty($site['photos_at'])@lang('almanac.admin.site_never')@endempty
                @notempty($site['photos_at'])
                    @notempty($site['photos_error']){{ $site['photos_error'] }}@endnotempty
                    @empty($site['photos_error'])
                        @lang('almanac.admin.site_found', ['count' => $site['photos_found']])
                    @endempty
                @endnotempty
            </span>

            <button type="submit" class="admin-btn admin-btn-sm">@lang('almanac.save')</button>
        </form>
        @endeach
    </div>
</div>

